DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trainingzone?schema=public"

# E10-07: región donde vive la base de datos. Tiene que coincidir con
# DECLARED_DATA_REGION (src/lib/data-region.ts), que es lo que publica
# /privacidad y lo que cita el registro de actividades. Si no coincide, o si
# apunta fuera del EEE, el servidor NO arranca: la base de datos guarda datos
# de salud y moverla es una transferencia internacional que hay que declarar.
# Con una base de datos en localhost se puede dejar vacía.
DATA_REGION="frankfurt"

# E10-13: plazo de preaviso del cargo domiciliado, en días naturales. El
# esquema SEPA Core exige 14 salvo PACTO DISTINTO recogido en las condiciones
# firmadas. Un plazo más corto que 14 solo se aplica si
# SEPA_PRENOTIFICATION_AGREED_IN_WRITING="true"; si no, se cae al general —la
# variable no es el pacto, es su reflejo en la máquina. Un plazo más largo
# siempre vale: beneficia al deudor.
SEPA_PRENOTIFICATION_DAYS="14"
SEPA_PRENOTIFICATION_AGREED_IN_WRITING="false"

# E10-08: conexión de MANTENIMIENTO del motor de conservación. `AuditLog` es
# append-only para el rol de la aplicación (E10-14: REVOKE UPDATE, DELETE), y
# el DELETE se dejó fuera del trigger justamente para que la purga por
# retención pueda borrar — con un rol distinto, que es el único que conserva el
# privilegio. Sin esta variable, la purga del log y la de organizaciones sin
# pagar NO se ejecutan y lo dicen en la respuesta del cron, en vez de fallar en
# silencio mientras el log crece sin fin.
DATA_RETENTION_DATABASE_URL=""

# E10-20: almacén de las fotos de composición corporal. Son fotos frontal, de
# perfil y de espalda, habitualmente en ropa interior, y hasta ahora vivían
# como `data:image/jpeg;base64,...` DENTRO de una columna de texto de Postgres:
# cualquier volcado de la base las entregaba legibles. Ahora la columna guarda
# solo una referencia y el fichero vive fuera, cifrado con AES-256-GCM
# (ADR-005).
#
# PROGRESS_PHOTO_KEY: 32 bytes en base64. Genérala con `openssl rand -base64 32`
# y NO reutilices la de este ejemplo en producción — perderla significa perder
# las fotos, y filtrarla equivale a publicarlas.
# PROGRESS_PHOTO_DIR: dónde viven los ficheros. Por defecto `.data/progress-photos`,
# FUERA de `public/`: un directorio servido estáticamente convertiría el enlace
# firmado en un adorno.
PROGRESS_PHOTO_KEY="ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE="
PROGRESS_PHOTO_DIR=""

# NextAuth
AUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Microsoft Entra ID (Azure AD) - preparado para producción, NO activo por defecto.
# Rellenar con los valores del App Registration en Azure Portal para habilitar
# el login corporativo con Microsoft. Con estas tres vacías, solo se usa el
# login demo (Credentials) contra los usuarios sembrados por prisma/seed.ts.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Google OAuth - preparado para producción, NO activo por defecto (igual que
# Microsoft). Rellenar con las credenciales OAuth de Google Cloud Console para
# habilitar el login con Google. Con estas dos vacías, el botón no se activa.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe - preparado para producción, NO activo por defecto. UNA SOLA clave
# secreta en todo el sistema: la de Apta (la plataforma). Cobra tanto el Plano 1
# (Apta → gimnasios, suscripción SaaS) como el Plano 2 (gimnasio → socios, vía
# Connect Standard + Stripe-Account: acct_...). Ningún gimnasio introduce nunca
# una clave propia. Con estas vacías, checkout/webhook degradan con un error
# controlado en vez de fallar.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# HU-ST-03/RB-PAGO-021: la versión de API de Stripe NO es configuración de
# entorno — se fija en el código (PINNED_STRIPE_API_VERSION, en
# src/lib/stripe-api-version.ts) para que un `npm update` no la cambie bajo los
# pies. Hoy: 2026-07-29.dahlia (SDK 22.5.0). Si el SDK instalado declara otra,
# el arranque lo avisa por log y sigue llamando con la fijada.

# Stripe Connect (Parte C: cada gimnasio cobra a sus socios en su propia
# cuenta). Client ID de la app Connect de Apta (Dashboard Stripe → Connect →
# Configuración), necesario para el botón "Conectar con Stripe" (OAuth
# Standard, C.3).
STRIPE_CONNECT_CLIENT_ID=""

# HU-ST-01/RB-PAGO-020: el endpoint que escucha "eventos de cuentas conectadas"
# tiene su PROPIO signing secret, distinto del de la cuenta de Apta. El webhook
# verifica contra los dos y enruta según cuál valida. Dejarlo vacío es válido y
# mantiene el comportamiento de un único endpoint (enrutado por `event.account`).
STRIPE_CONNECT_WEBHOOK_SECRET=""

# Catálogo comercial (Apta → gimnasios). Los identificadores de precio de Stripe
# NO viven en el código: cambian entre test y live y son configuración de entorno
# (RB-PLAN-001). Un plan sin precio aquí simplemente no se ofrece en /planes.
STRIPE_PRICE_ESENCIAL_MES=""
STRIPE_PRICE_ESENCIAL_ANO=""
STRIPE_PRICE_AVANZADO_MES=""
STRIPE_PRICE_AVANZADO_ANO=""
STRIPE_PRICE_ELITE_MES=""
STRIPE_PRICE_ELITE_ANO=""

# Oferta "Fundador" (lifetime): limitada en tiempo y en unidades. Con el
# interruptor en false no aparece en /planes aunque tenga precio configurado.
STRIPE_PRICE_FUNDADOR=""
PLATFORM_PLAN_FUNDADOR_ENABLED="false"
PLATFORM_PLAN_FUNDADOR_MAX_SEATS="25"

# Cron de reglas de negocio (/api/jobs/run) - secreto compartido con el
# disparador externo (Vercel Cron u otro) que llama a esa ruta periódicamente.
# Si se deja vacío, la ruta responde 503 y no ejecuta ninguna regla (falla
# cerrado: nunca queda abierta sin autenticar).
JOBS_CRON_SECRET=""

# RB-RES-005: horas de antelación mínima para cancelar una reserva sin perder
# la sesión de tu bono. Por debajo de esta ventana, cancelar sigue estando
# permitido pero la sesión se da por empleada (no se devuelve al bono). Vacía
# o no numérica → 24 horas por defecto.
CANCELLATION_WINDOW_HOURS="24"

# Email transaccional (invitaciones, altas...) vía la API HTTP de Brevo
# (https://www.brevo.com) - preparado para producción, NO activo por
# defecto. Se usa la API HTTP en vez de SMTP porque muchos hosts (Render
# incluido, en su plan gratuito) bloquean los puertos SMTP salientes.
# BREVO_API_KEY: Brevo → Settings → SMTP & API → pestaña "API Keys".
# BREVO_FROM_EMAIL: dirección verificada en Brevo → Senders & IP → Senders.
# Con BREVO_API_KEY vacía, el envío se simula registrando el email en el
# log del servidor.
BREVO_API_KEY=""
BREVO_FROM_EMAIL=""

# Dirección postal del pie de los correos cuando no se puede sacar la del
# centro (`Center.address`): correos de plataforma, o un centro sin dirección
# cargada. El pie de un correo comercial tiene que llevar una dirección física.
EMAIL_POSTAL_ADDRESS="Av. de Cataluña 42, 50014 Zaragoza"

# Claude API (@anthropic-ai/sdk) - generación y refinado de mesociclos (F6).
# Preparado para producción, NO activo por defecto: con la clave vacía la
# generación degrada con un error controlado en la propia pestaña, igual que
# Stripe y Brevo. Clave en https://console.anthropic.com → API Keys.
# Coste medido: ~0,18 $ generar un mesociclo, ~0,06 $ refinarlo.
ANTHROPIC_API_KEY=""

# ---------- SEO y analítica (E9-09) ----------
# Analítica SIN COOKIES (Plausible por defecto). Sin dominio configurado no se
# carga ningún script: es lo que se quiere en desarrollo, en CI y en cualquier
# entorno de vista previa, donde medir es contaminar la medición de producción.
# Se eligió sin cookies para no arrastrar banner de consentimiento en la landing
# (Art. 22.2 LSSI): un banner en la única página comercial que hay cuesta
# conversión y añade CLS por encima del hero.
NEXT_PUBLIC_ANALYTICS_DOMAIN=""
# Opcional: URL del script, para poder autoalojarlo.
NEXT_PUBLIC_ANALYTICS_SRC=""

# Google Search Console. La verificación buena es la de DNS (cubre el dominio
# entero, subdominios incluidos, y no se pierde al redesplegar); esta meta es la
# segunda vía, la que sobrevive a un cambio de proveedor de DNS.
GOOGLE_SITE_VERIFICATION=""

# Origen público canónico (src/lib/site.ts). Permite separar el dominio de
# marketing del de autenticación el día que dejen de ser el mismo. Si se deja
# vacío se usa NEXTAUTH_URL.
NEXT_PUBLIC_SITE_URL=""

# E9-12: hosts desde los que se aceptan logos de organización para OPTIMIZAR con
# next/image (lista separada por comas; se admite "*.midominio.com"). Lo que no
# case se sirve sin optimizar pero con su caja declarada, así que el CLS queda
# arreglado igual. NO se abre a "**" a propósito: eso convertiría el optimizador
# de Next en un proxy de imágenes abierto.
NEXT_PUBLIC_LOGO_HOSTS=""
