// TRAINING ZONE — modelo de datos multi-tenant (ADR-003/004)
// Aislamiento por organización vía orgId ("tenant_id") en cada tabla de negocio.
// En producción sobre Postgres real se añadiría Row Level Security (ADR-004);
// aquí el aislamiento se aplica en la capa de acceso a datos (lib/tenant.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Tenancy ----------

// Estado de la suscripción del gimnasio a Apta (Plano 1 — cobro de
// plataforma, docs/PLATAFORMA_COBRO_SMTP_STRIPE_CONNECT_IMPLEMENTACION.md
// Parte A). Distinto del cobro del gimnasio a sus socios (Plano 2 — Parte C).
enum PlatformStatus {
  PENDING_PAYMENT // registrada, aún no ha pagado (D-3). No usable (muro). Purgable por TTL (D-5).
  TRIALING // opcional: acceso durante prueba (si se ofrece trial)
  ACTIVE // suscripción al día → app usable
  PAST_DUE // cobro recurrente falló; periodo de gracia antes de suspender
  SUSPENDED // impago persistente; solo-lectura. NUNCA se purga (D-6)
  CANCELLED // baja definitiva del cliente
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String? // logo de marca para el NavBar; si es null se usa el de Apta
  createdAt DateTime @default(now())

  // ---------- Cobro de plataforma (Apta → gimnasio, Parte A) ----------
  platformStatus               PlatformStatus @default(PENDING_PAYMENT)
  platformStatusSince          DateTime       @default(now()) // base del TTL de purga (D-5)
  platformPlan                 String? // código de PlatformPlan (src/lib/platform-plans.ts); null hasta pagar
  trialEndsAt                  DateTime?
  currentPeriodEnd             DateTime? // fin de ciclo (espejo de la suscripción de Stripe)
  // Datos fiscales para la factura (D-4). No verifican "es director", son para facturar.
  taxId                        String?
  billingEmail                 String?
  billingName                  String?
  // Suscripción en el Stripe DE APTA (Plano 1). Distinto de StripeAccount (Plano 2, Parte C).
  platformStripeCustomerId     String?        @unique
  platformStripeSubscriptionId String?        @unique
  /// Idempotencia del alta (RB-ALTA-001): la sesión de checkout que dio origen a esta
  /// organización. Un reenvío del webhook la encuentra y no crea una segunda ni
  /// reenvía el email de bienvenida.
  provisioningSessionId        String?        @unique

  stripeAccount StripeAccount?

  centers           Center[]
  users             User[]
  members           Member[]
  plans             MembershipPlan[]
  sessions          ClassSession[]
  templates         SessionTemplate[]
  payments          Payment[]
  auditLogs         AuditLog[]
  aptitudeRules     AptitudeRule[]
  centerMemberships CenterMembership[]
  memberNotes       MemberNote[]
  invitations       Invitation[]

  leads                  Lead[]
  leadNotes              LeadNote[]
  leadChannels           LeadChannel[]
  noCloseReasons         NoCloseReason[]
  clientGoals            ClientGoal[]
  notifications          Notification[]
  workoutPrograms        WorkoutProgram[]
  selfAssessments        SelfAssessment[]
  conversations          Conversation[]
  timeClockEntries       TimeClockEntry[]
  trainerRatings         TrainerRating[]
  checkinScheduleConfigs CheckinScheduleConfig[]
  referenceRanges        ReferenceRange[]
  announcements          Announcement[]
  onlineWorkouts         OnlineWorkout[]
  assessments            Assessment[]
  performanceMetrics     PerformanceMetric[]
  mesocycles             Mesocycle[]
}

model Center {
  id                   String   @id @default(cuid())
  orgId                String
  name                 String
  slug                 String
  address              String?
  // Coordenadas del centro. Opcionales: un centro sin situar sigue operando
  // igual, solo deja de pintarse en el mapa de barrios (marcador, anillo de
  // 15 min andando y distancia por barrio, ver getPostalCodeMapData).
  lat                  Float?
  lng                  Float?
  logoUrl              String? // logo propio del centro; si es null se hereda el de la organización (y en su defecto, Apta)
  timezone             String   @default("Europe/Madrid")
  // Aforo por defecto de las sesiones de grupo del centro. Solo semilla del
  // formulario de alta: cambiarlo NO altera plantillas ni sesiones ya creadas,
  // que llevan su propia capacidad (SessionTemplate/ClassSession.capacity).
  defaultGroupCapacity Int?
  createdAt            DateTime @default(now())

  organization     Organization       @relation(fields: [orgId], references: [id])
  users            User[]
  members          Member[]           @relation("PrimaryCenter")
  templates        SessionTemplate[]
  sessions         ClassSession[]
  staffMemberships CenterMembership[]
  leads            Lead[]
  timeClockEntries TimeClockEntry[]
  announcements    Announcement[]
  subscriptions    Subscription[]

  @@unique([orgId, slug])
  @@index([orgId])
}

// ---------- Referencia geográfica (BI-3): CP completo → barrio/zona ----------
// Tabla de referencia NO multi-tenant (es geografía, no dato de negocio de una
// org concreta). Antes agrupaba por los 2 primeros dígitos del CP (provincia,
// ver el histórico de PostalProvince); se sustituyó por CP completo → barrio
// porque la primera puesta en preproducción solo tiene socios/leads de
// Zaragoza capital, y a esa escala la provincia deja de aportar detalle —
// interesa ver la distribución barrio a barrio. Se persiste aquí (en vez de
// vivir solo en lib/postal-codes-zaragoza.ts) para que getPostalCodeStats
// pueda hacer el join en una sola query SQL — así el mapa de calor y el
// ranking de barrios leen exactamente el mismo dataset y no pueden mostrar
// totales distintos entre sí. Para expandir a otras ciudades, añadir aquí
// (vía lib/postal-codes-zaragoza.ts, o un fichero por ciudad) sus CP → barrio.
model PostalCodeArea {
  code String @id // CP completo de 5 dígitos, p.ej. "50007"
  name String // barrio o zona al que pertenece ese CP
  lat  Float
  lng  Float
}

// ---------- Identidad y roles ----------

enum Role {
  PLATFORM_ADMIN
  OWNER
  CENTER_DIRECTOR
  TRAINER
  RECEPTION
  MEMBER
  HR_MANAGER // RRHH: gestiona personal e imputación a centros, sin acceso a datos de salud
  TRAINER_ADMIN // Entrenador con mando sobre su centro: aforo por defecto y ajuste de bonos
}

/// Credencial de acceso, única GLOBAL (RB-ID-001). Está separada de la membresía
/// (`User`) para que una misma persona pueda pertenecer a varias organizaciones
/// —o ser staff y socia a la vez— sin colisionar por email: antes `User.email`
/// era único global y el alta de un socio que ya existía en otro gimnasio
/// reventaba con violación de unicidad.
model Identity {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  /// null = la credencial existe pero nunca se fijó una contraseña real (se creó al
  /// invitar, con un hash aleatorio inutilizable). Distinguirlo explícitamente evita
  /// tener que deducirlo del hash: es lo que permite que una segunda invitación a
  /// alguien que ya está en Apta no le vuelva a pedir contraseña (RB-ID-003).
  passwordSetAt   DateTime?
  emailVerifiedAt DateTime? // D-2: confirmación blanda del email (no bloquea el login)
  authProvider    String    @default("password") // "password" | "microsoft-entra-id" | "google"
  createdAt       DateTime  @default(now())

  memberships User[]
}

/// Membresía de una identidad en una organización, con su rol y su ámbito de
/// centro. Una identidad tiene N (normalmente 1). El aislamiento multi-tenant
/// sigue colgando de `orgId` exactamente como antes.
enum ThemePreference {
  LIGHT
  DARK
}

model User {
  id           String   @id @default(cuid())
  identityId   String
  orgId        String
  centerId     String?
  name         String
  email        String // desnormalizado desde Identity: evita un join en cada listado
  role         Role
  image        String?
  // D7 del handoff: si está activo, su foto y su nombre acompañan a las
  // sesiones que dirige en la app del socio.
  visibleInApp Boolean  @default(true)
  // Tema de la aplicación elegido por la persona. Vive en `User` (no en
  // `Identity` ni en `Member`): el personal no tiene ficha de socio y las
  // preferencias de interfaz ya se guardan por membresía.
  theme        ThemePreference @default(LIGHT)
  // Baja de plantilla (RB-RRHH-014). Marcar en vez de borrar es lo único que
  // permite sacar a alguien del equipo sin llevarse por delante lo que cuelga
  // de su fila y no es suyo: el registro de jornada (de conservación
  // obligatoria), los mesociclos de sus socios, las valoraciones que recibió o
  // el debrief que firmó. Cuando no hay nada de eso, la baja sí borra la fila
  // (ver `removeStaffMember` en lib/staff-lifecycle.ts). Quien está de baja no
  // sale en la plantilla, no se puede asignar a nada y no puede entrar.
  deactivatedAt DateTime?
  createdAt    DateTime @default(now())

  identity              Identity           @relation(fields: [identityId], references: [id], onDelete: Cascade)
  organization          Organization       @relation(fields: [orgId], references: [id])
  center                Center?            @relation(fields: [centerId], references: [id])
  trainerSessions       ClassSession[]     @relation("TrainerSessions")
  trainerTemplates      SessionTemplate[]  @relation("TrainerTemplates")
  memberProfile         Member?            @relation("MemberUser")
  auditLogs             AuditLog[]
  healthReported        HealthRecord[]     @relation("ReportedBy")
  aptitudeRulesEdited   AptitudeRule[]     @relation("EditedBy")
  referenceRangesEdited ReferenceRange[]   @relation("EditedReferenceRange")
  centerMemberships     CenterMembership[]
  memberNotesAuthored   MemberNote[]       @relation("MemberNoteAuthor")
  invitation            Invitation?

  leadsOwned               Lead[]               @relation("LeadOwner")
  leadNotesAuthored        LeadNote[]           @relation("LeadNoteAuthor")
  directedSessions         ClassSession[]       @relation("DirectedSessions")
  workoutProgramsConfirmed WorkoutProgram[]     @relation("WorkoutConfirmedBy")
  mobileRefreshTokens      MobileRefreshToken[]
  notifications            Notification[]       @relation("NotificationRecipient")
  notificationsCreated     Notification[]       @relation("NotificationCreator")
  timeClockEntries         TimeClockEntry[]
  trainerRatingsReceived   TrainerRating[]      @relation("TrainerRatingSubject")
  paymentsSold             Payment[]            @relation("SoldBy")
  chatMessagesSent         ChatMessage[]
  announcementsAuthored    Announcement[]       @relation("AnnouncementAuthor")
  trainerDebriefsGiven     TrainerDebrief[]
  assessmentsFilled        Assessment[]         @relation("AssessmentFilledBy")
  mesocyclesCreated        Mesocycle[]          @relation("MesocycleCreatedBy")
  mesocyclesApproved       Mesocycle[]          @relation("MesocycleApprovedBy")

  // Sustituye al @unique global de email: el mismo email puede tener membresía
  // en varias organizaciones, pero solo una dentro de cada una.
  @@unique([orgId, email])
  @@index([identityId])
  @@index([orgId])
  @@index([orgId, deactivatedAt])
}

// ---------- Invitaciones (F7 self-service + alta de personal/socios) ----------
// Token de un solo uso para que personal y socios creen su contraseña
// (personal) o contraseña + consentimientos (socios). Caduca a los 7 días
// (RB descrita en el handoff). Sin backend de email real en esta demo: el
// enlace se registra vía lib/mailer.ts (log de servidor).

enum InvitationType {
  STAFF
  MEMBER
  OWNER // activación del director tras el pago (alta pago-primero)
}

model Invitation {
  id        String         @id @default(cuid())
  orgId     String
  type      InvitationType
  token     String         @unique
  email     String
  userId    String?        @unique
  memberId  String?        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  member       Member?      @relation(fields: [memberId], references: [id])

  @@index([orgId])
  @@index([expiresAt])
}

// Imputación de personal a centros: relación N:N staff ↔ centro con un rol y un
// % de dedicación por centro. Permite que una persona trabaje en varios centros
// con roles distintos; `User.role`/`User.centerId` quedan como rol y centro base
// (retrocompatibilidad). El ámbito efectivo se resuelve contra esta tabla.
model CenterMembership {
  id            String    @id @default(cuid())
  orgId         String
  userId        String
  centerId      String
  role          Role
  isPrimary     Boolean   @default(false)
  allocationPct Int? // % de jornada imputado a este centro (0-100)
  startDate     DateTime  @default(now())
  endDate       DateTime?
  createdAt     DateTime  @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  center       Center       @relation(fields: [centerId], references: [id])

  @@unique([userId, centerId])
  @@index([orgId])
  @@index([centerId])
  @@index([userId])
}

// ---------- Socio y catálogo comercial (A.2.1) ----------

enum MemberState {
  PROSPECT
  TRIAL
  ACTIVE
  DELINQUENT
  FROZEN
  CANCELLED
}

// Sexo del socio (columna "Sexo" del export externo: Mujer/Hombre/Otro).
enum Sex {
  FEMALE
  MALE
  OTHER
}

// Riesgo de abandono heredado del export (MyWellness "Riesgo de abandono":
// Baja/Media/Alta). Es la señal del sistema de origen; el motor de retención
// propio (G.3) sigue calculando su RetentionAlert por separado.
enum ChurnRisk {
  LOW
  MEDIUM
  HIGH
}

model Member {
  id                 String      @id @default(cuid())
  orgId              String
  primaryCenterId    String
  userId             String?     @unique
  firstName          String
  lastName           String
  email              String
  phone              String?
  birthDate          DateTime?
  address            String?
  emergencyContact   String?
  photoUrl           String? // foto de perfil (subida como data URL en esta demo)
  state              MemberState @default(PROSPECT)
  joinedAt           DateTime    @default(now())
  cancelledAt        DateTime?
  consentContract    Boolean     @default(true)
  consentHealth      Boolean     @default(false)
  consentImages      Boolean     @default(false) // uso de imágenes (fotos de evolución)
  consentMarketing   Boolean     @default(false)
  consentAI          Boolean     @default(false) // tratamiento por IA de sus datos (valoraciones, mesociclos)
  consentContractAt  DateTime?
  consentHealthAt    DateTime?
  consentImagesAt    DateTime?
  consentMarketingAt DateTime?
  consentAIAt        DateTime?
  consentVersion     String? // versión del texto legal firmado en el onboarding

  // --- Preferencias de correo (pie "Preferencias" / "Darme de baja") ---
  // El correo estrictamente transaccional (acceso, contraseña, cobros) no se
  // puede desactivar: es parte del servicio contratado y sin él el socio se
  // queda sin poder pagar ni entrar. Lo que sí se puede parar es todo lo demás.
  notifyVacancies    Boolean     @default(true) // avisos de plaza liberada
  notifyBirthday     Boolean     @default(true) // felicitación de cumpleaños
  notifyAssessments  Boolean     @default(true) // recordatorio de valoración pendiente
  /// Baja global de todo el correo no imprescindible. Se guarda la fecha, no un
  /// booleano, porque es la prueba de cuándo se ejerció la oposición (Art. 21 RGPD).
  emailOptOutAt      DateTime?
  notes              String?
  createdAt          DateTime    @default(now())

  // RB-PERFIL: perfil extendido (F9) — CP/ocupación/canal heredados del lead de origen.
  // Ya no hay entrenador responsable fijo: el socio puede hacer EP con distintos
  // entrenadores según la sesión (ver ClassSession.trainerId/SessionTemplate.trainerId).
  postalCode       String?
  occupation       String?
  hasChildren      Boolean? // BI demográfico (RB-BI-003), heredado del lead si se respondió
  channel          String?
  heightCm         Int? // composición corporal: base para IMC/rangos de referencia (docs/COMPOSICION_CORPORAL_*)
  originLeadId     String?  @unique
  stripeCustomerId String?  @unique // F12 (RB-PAGO-001): cliente Stripe para cobros recurrentes
  stripeAccountId  String? // F5: cuenta CONECTADA del gimnasio donde vive ese cliente — si el gimnasio reconecta otra, invalida el espejo

  // --- Importación de socios desde export externo (F-IMPORT / RB-IMPORT) ---
  // El director puede importar un CSV de socios exportado de otra plataforma
  // (p.ej. MyWellness/Technogym). Estos campos capturan las columnas del export
  // que no encajaban en el perfil base. `externalRef` (el "Identificador de la
  // nube" del origen) es la clave estable que hace la reimportación idempotente:
  // volver a subir el mismo CSV actualiza al socio en vez de duplicarlo.
  sex                 Sex?
  addressLine2        String? // "Dirección 2" (la línea 1 va a `address`)
  city                String?
  province            String?
  country             String?
  churnRisk           ChurnRisk? // "Riesgo de abandono" del origen
  primaryAspiration   String? // "Aspiración principal" (Move/Shape/Power/Sport/Balance/Fun)
  secondaryAspiration String? // "Aspiración secundaria"
  lastAccessAt        DateTime? // "Último acceso"
  lastInteractionAt   DateTime? // "Última interacción"
  accountCreatedAt    DateTime? // "Fecha de creación de la cuenta"
  mywellnessAccount   String? // "Cuenta mywellness" (login del socio en el origen)
  externalId          String? // "ID externo" del sistema de origen
  externalSource      String? // procedencia del registro ("mywellness" | ...)
  externalRef         String? // "Identificador de la nube" — clave de idempotencia de la importación

  organization        Organization          @relation(fields: [orgId], references: [id])
  primaryCenter       Center                @relation("PrimaryCenter", fields: [primaryCenterId], references: [id])
  user                User?                 @relation("MemberUser", fields: [userId], references: [id])
  originLead          Lead?                 @relation("MemberOriginLead", fields: [originLeadId], references: [id])
  subscriptions       Subscription[]
  bookings            Booking[]
  payments            Payment[]
  healthRecords       HealthRecord[]
  retentionAlerts     RetentionAlert[]
  noteEntries         MemberNote[]
  progressEntries     MemberProgressEntry[]
  invitation          Invitation?
  convertedFromLead   Lead?                 @relation("LeadConvertedMember")
  clientGoals         ClientGoal[]
  workoutPrograms     WorkoutProgram[]
  selfAssessments     SelfAssessment[]
  conversation        Conversation?
  trainerRatingsGiven TrainerRating[]
  announcementViews   AnnouncementView[]
  clientFeedback      ClientFeedback[]
  trainerDebriefs     TrainerDebrief[]
  assessments         Assessment[]
  performanceMetrics  PerformanceMetric[]
  mesocycles          Mesocycle[]

  @@unique([orgId, externalRef]) // idempotencia de la importación por socio del origen
  @@index([orgId])
  @@index([primaryCenterId])
  @@index([state])
}

// Fotos y métricas de evolución física (Ficha Socio). Visibles solo para el
// socio y el equipo del centro (mismo ámbito que health-access).
model MemberProgressEntry {
  id            String   @id @default(cuid())
  memberId      String
  date          DateTime @default(now())
  weightKg      Float?
  bodyFatPct    Float?
  waistCm       Float?
  photoFrontUrl String?
  photoSideUrl  String?
  photoBackUrl  String?
  createdAt     DateTime @default(now())

  // Composición corporal (bioimpedancia, p.ej. Tanita) — docs/COMPOSICION_CORPORAL_TANITA.md §3.
  // Todos opcionales: una fila puede seguir siendo un registro "solo peso/fotos" como hasta ahora.
  // Dato Art. 9 RGPD (RB-PERFIL-004): mismo tratamiento que HealthRecord, ver lib/health-access.ts.
  muscleMassKg      Float? // masa muscular
  fatMassKg         Float? // masa grasa (kg)
  fatFreeMassKg     Float? // masa magra / libre de grasa
  bodyWaterPct      Float? // agua corporal (%)
  boneMassKg        Float? // masa ósea
  visceralFatRating Int? // grasa visceral (rating Tanita, no %)
  muscleQuality     Int? // "calidad muscular" (MQ Tanita)
  bmrKcal           Int? // metabolismo basal
  metabolicAge      Int? // edad metabólica
  bmi               Float? // IMC (se guarda además de derivarse, para no depender de heightCm al recalcular históricos)
  segmental         Json? // análisis por segmento: tronco/brazos/piernas {fatPct, muscleKg}
  source            String    @default("MANUAL") // "MANUAL" | "TANITA" (pegado desde MyTanita)
  measuredAt        DateTime? // fecha real de la toma (≠ createdAt), relevante en importaciones

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId])
}

// Rangos de referencia de composición corporal (RB-PERFIL-004 / semáforo en la ficha del socio).
// Tabla editable por dirección — no hardcode — misma filosofía que AptitudeRule.
model ReferenceRange {
  id     String  @id @default(cuid())
  orgId  String
  metric String // "bodyFatPct" | "bmi" | "visceralFatRating" | "bodyWaterPct" ...
  sex    String? // null = aplica a ambos
  ageMin Int?
  ageMax Int?
  min    Float?
  max    Float?

  editedByUserId String?
  updatedAt      DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  editedBy     User?        @relation("EditedReferenceRange", fields: [editedByUserId], references: [id])

  @@index([orgId])
  @@index([orgId, metric])
}

// Bitácora de comentarios internos del socio (RB-LEAD-008): lista cronológica
// "nota + autor + fecha", DISTINTA de los datos clínicos de HealthRecord. No es
// dato del Art. 9 RGPD, así que la ve cualquier rol de staff (no pasa por
// health-access). Lo clínico va siempre a HealthRecord.
// Bitácora interna del staff sobre el socio (RB-LEAD-008). Observaciones
// puntuales y leves ("hoy venía con agujetas", "prefiere entrenar temprano"):
// un diagnóstico médico o cualquier cosa persistente va a HealthRecord, que
// tiene su propio control de acceso y auditoría (ADR-008). Esta bitácora se ve
// con los permisos generales de la ficha, sin consentimiento ni registro de
// lectura, así que no debe usarse como historial clínico encubierto.
model MemberNote {
  id           String   @id @default(cuid())
  orgId        String
  memberId     String
  authorUserId String?
  body         String
  // Destacada: sube al bloque de cabecera de Actividad y no caduca con el
  // tiempo, para que el entrenador la vea antes de la sesión aunque sea vieja.
  important    Boolean  @default(false)
  // Archivada: deja de pintarse en el hilo y en el bloque destacado, pero la
  // fila se conserva y sigue siendo consultable. Nunca se borra una nota.
  archivedAt   DateTime?
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  member       Member       @relation(fields: [memberId], references: [id])
  author       User?        @relation("MemberNoteAuthor", fields: [authorUserId], references: [id])

  @@index([orgId])
  @@index([memberId])
  // El hilo y el bloque destacado piden siempre "las de este socio sin
  // archivar, de la más nueva a la más vieja".
  @@index([memberId, archivedAt, createdAt])
}

// Objetivos concretos de salud/rendimiento del socio (RB-PERFIL-003). Catálogo
// editable por dirección: las filas con isTemplate=true son el catálogo de
// partida (sin memberId real, se clonan al asignar), las demás son objetivos
// asignados a un socio concreto.
model ClientGoal {
  id         String    @id @default(cuid())
  orgId      String
  memberId   String? // null en filas de catálogo (isTemplate=true)
  label      String
  isTemplate Boolean   @default(false)
  achievedAt DateTime?
  createdAt  DateTime  @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  member       Member?      @relation(fields: [memberId], references: [id])

  @@index([orgId])
  @@index([memberId])
}

enum PlanType {
  MONTHLY
  SESSION_PACK
  DROP_IN
  PERSONAL_TRAINING
  DUO
  ONLINE
}

model MembershipPlan {
  id               String   @id @default(cuid())
  orgId            String
  name             String
  type             PlanType
  sessionsIncluded Int?
  priceCents       Int
  validityDays     Int?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  // Catálogo de la app móvil (handoff "App móvil premium", A2/D4/D5): el socio
  // compra el bono desde el primer login, así que el plan necesita texto de
  // venta y foto. `active` es la visibilidad: un plan oculto no aparece en el
  // catálogo pero sigue vivo para quien ya lo tiene contratado.
  description String?
  imageUrl    String? // 1600 × 1000 recomendado (data URL, igual que el resto de imágenes de la demo)

  // F5 (RB-VENTA-002): espejo del producto/precio en la cuenta CONECTADA del
  // gimnasio. Los precios de Stripe son inmutables — cambiar el importe crea
  // un precio nuevo y las suscripciones vivas conservan el anterior.
  // `stripeAccountId` permite detectar que el gimnasio reconectó otra cuenta
  // e invalidar el espejo.
  stripeProductId String?
  stripePriceId   String?
  stripeAccountId String?

  organization  Organization   @relation(fields: [orgId], references: [id])
  subscriptions Subscription[]

  @@index([orgId])
}

enum SubscriptionStatus {
  ACTIVE
  FROZEN
  CANCELLED
  EXPIRED
}

model Subscription {
  id                String             @id @default(cuid())
  memberId          String
  planId            String
  startDate         DateTime
  endDate           DateTime?
  status            SubscriptionStatus @default(ACTIVE)
  priceCents        Int
  sessionsRemaining Int?
  createdAt         DateTime           @default(now())

  // RB-RES-006: capacidad contratada de ESTE bono, copiada de
  // `plan.sessionsIncluded` al crearlo. Sin esto, "sesiones gastadas" se
  // calculaba siempre contra el total del PLAN (compartido por todos los
  // socios que lo tienen contratado), así que sumarle sesiones a un bono
  // concreto (bonos-actions.ts::adjustSubscriptionSessions) solo podía subir
  // `sessionsRemaining` — en cuanto el saldo alcanzaba lo contratado, la
  // fórmula de session-balance.ts (`total = max(included, remaining)`)
  // interpretaba el bono entero como recién estrenado y el consumo previo
  // desaparecía de la pantalla (un bono de 4 agotado + 2 sesiones de regalo
  // pasaba a verse "6/6" en vez de "4/6"). Nullable para no romper los bonos
  // ilimitados (`sessionsRemaining` null); se hace fallback a
  // `plan.sessionsIncluded` donde pueda faltar (bonos anteriores a esta
  // columna).
  sessionsIncluded Int?

  // PAGO-1 (RB-PAGO-004/006): congelación temporal y cancelación programada.
  pauseUntil DateTime? // null + status=FROZEN = congelación indefinida
  cancelAt   DateTime? // fecha futura en la que el job de F10 pasa a CANCELLED

  // RB-AGENDA-003: el bono, no `Member.primaryCenterId`, decide dónde puede
  // reservar el socio. Un socio puede tener varios bonos ACTIVE a la vez si son
  // de distinta modalidad (EP/grupos), y pueden ser de centros distintos de la
  // misma organización.
  centerId String

  // F5 (RB-VENTA-002): id de la Subscription recurrente en Stripe Billing
  // (cuenta conectada del gimnasio). Null para bonos puntuales (no recurrentes).
  stripeSubscriptionId String? @unique

  member   Member         @relation(fields: [memberId], references: [id])
  plan     MembershipPlan @relation(fields: [planId], references: [id])
  center   Center         @relation(fields: [centerId], references: [id])
  payments Payment[]
  bookings Booking[]

  @@index([memberId])
  @@index([centerId])
}

// ---------- Feedback (cliente vs. debrief del entrenador) ----------
// Página "Feedback" de Dirección: contrasta lo que el socio reporta
// (ClientFeedback) con lo que registra su entrenador en el debrief
// (TrainerDebrief), ambos sobre las mismas 9 dimensiones 0-10 (sliders, cero
// texto obligatorio en ninguno de los dos lados), para detectar
// desalineaciones de percepción ("puntos ciegos") con la mayor precisión
// posible. Solo importa el más reciente de cada uno por socio; los agregados
// (medias, gap, categoría) se calculan en `lib/feedback-queries.ts`, nunca se
// persisten.
model ClientFeedback {
  id           String   @id @default(cuid())
  orgId        String // aislamiento propio: antes solo se navegaba vía Member (E3 del audit)
  memberId     String
  periodKey    String // "YYYY-MM": ancla el ciclo para emparejar con el TrainerDebrief del mismo periodo
  sat          Int
  prog         Int
  adher        Int
  motiv        Int
  esf          Int
  descanso     Int
  nutricion    Int
  bienestar    Int
  comunicacion Int
  comment      String?
  submittedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])

  @@index([orgId])
  @@index([memberId])
  @@index([periodKey])
}

model TrainerDebrief {
  id               String    @id @default(cuid())
  orgId            String // aislamiento propio: antes solo se navegaba vía Member (E3 del audit)
  memberId         String
  trainerId        String
  periodKey        String // "YYYY-MM": ancla el ciclo para emparejar con el ClientFeedback del mismo periodo
  sat              Int
  prog             Int
  adher            Int
  motiv            Int
  esf              Int
  descanso         Int
  nutricion        Int
  bienestar        Int
  comunicacion     Int
  note             String
  debriefAt        DateTime  @default(now())
  reviewedAt       DateTime? // "Marcar como revisado" de dirección (/feedback)
  reviewedByUserId String?
  createdAt        DateTime  @default(now())

  member  Member @relation(fields: [memberId], references: [id])
  trainer User   @relation(fields: [trainerId], references: [id])

  @@index([orgId])
  @@index([memberId])
  @@index([trainerId])
  @@index([periodKey])
}

// ---------- Agenda y reservas (A.2.2) ----------

model SessionTemplate {
  id          String   @id @default(cuid())
  orgId       String
  centerId    String
  name        String
  classType   String
  weekday     Int // 0=domingo .. 6=sábado
  startTime   String // "HH:mm"
  durationMin Int
  capacity    Int
  room        String?
  trainerId   String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  organization Organization   @relation(fields: [orgId], references: [id])
  center       Center         @relation(fields: [centerId], references: [id])
  trainer      User?          @relation("TrainerTemplates", fields: [trainerId], references: [id])
  sessions     ClassSession[]

  @@index([orgId])
  @@index([centerId])
}

enum SessionStatus {
  SCHEDULED
  CANCELLED
}

model ClassSession {
  id         String        @id @default(cuid())
  orgId      String
  centerId   String
  templateId String?
  name       String
  classType  String
  date       DateTime // fecha (medianoche) del día de la sesión
  startTime  String // "HH:mm"
  endTime    String // "HH:mm"
  capacity   Int
  room       String?
  trainerId  String?
  status     SessionStatus @default(SCHEDULED)
  createdAt  DateTime      @default(now())

  // RB-AGENDA-002/004: hueco de EP (classType="PERSONAL_TRAINING", capacity=1).
  // selfBookable distingue la franja abierta a autorreserva del cliente de EP
  // (RB-AGENDA-001/002) de la reservada a mano por el entrenador. directedByUserId
  // registra quién dirigió realmente la sesión (verificación cruzada F13/RB-RRHH-002),
  // que puede diferir del entrenador asignado en la plantilla.
  selfBookable     Boolean @default(false)
  directedByUserId String?

  // Rediseño de agenda estilo Google Calendar: recurrencia simple (una fila
  // representa toda la serie; las ocurrencias en otras semanas se derivan en
  // lectura a partir de `date`/`recurrence`/`recUntil`, sin materializarlas).
  recurrence SessionRecurrence @default(NONE)
  recUntil   DateTime?
  isTrial    Boolean           @default(false)

  organization Organization     @relation(fields: [orgId], references: [id])
  center       Center           @relation(fields: [centerId], references: [id])
  template     SessionTemplate? @relation(fields: [templateId], references: [id])
  trainer      User?            @relation("TrainerSessions", fields: [trainerId], references: [id])
  directedBy   User?            @relation("DirectedSessions", fields: [directedByUserId], references: [id])
  bookings     Booking[]

  @@index([orgId])
  @@index([centerId, date])
}

enum SessionRecurrence {
  NONE
  WEEKLY
  WEEKDAYS
}

// RB-RES-009: por qué el cliente no se presentó. Es un enum cerrado y no texto
// libre porque de él dependen dos decisiones: si la falta cuenta como "sin
// aviso" para la alerta a dirección (LATE_NOTICE y JUSTIFIED no cuentan) y qué
// se le enseña al entrenador en el historial.
enum NoShowReason {
  FORGOT // No se presentó y no avisó
  LATE_NOTICE // Avisó, pero fuera de la ventana de cancelación
  JUSTIFIED // Causa justificada (enfermedad, imprevisto)
  OUR_ERROR // Fallo del centro (mal agendada, aviso no registrado)
}

enum BookingStatus {
  BOOKED
  WAITLISTED
  CANCELLED
  ATTENDED
  NO_SHOW
}

model Booking {
  id               String        @id @default(cuid())
  sessionId        String
  memberId         String
  status           BookingStatus @default(BOOKED)
  waitlistPosition Int?
  bookedAt         DateTime      @default(now())
  checkedInAt      DateTime?
  cancelledAt      DateTime?

  // Día concreto al que corresponde la reserva (medianoche local, misma
  // codificación que `ClassSession.date`). Una serie recurrente es UNA fila de
  // ClassSession y sus ocurrencias se derivan en lectura, así que sin este
  // campo todas las reservas de la serie colgaban del mismo `sessionId` y se
  // mezclaban: quien reservaba el martes que viene aparecía en el brief de hoy,
  // el aforo se contaba sumando semanas distintas y "mis próximas reservas"
  // usaba la fecha base de la serie. En una sesión sin recurrencia coincide
  // siempre con `session.date`.
  occurrenceDate DateTime

  // Bono del que se descontó la sesión al reservar (RB-RES-006): al cancelar se
  // devuelve el saldo a esta misma suscripción. Null cuando la reserva no
  // consumió bono (cuota ilimitada/online, o entró en lista de espera).
  subscriptionId String?

  // RB-RES-009: al marcar "No asistió" el entrenador registra SIEMPRE el motivo
  // y decide en ese momento si la sesión vuelve al bono. Antes la falta no
  // devolvía nunca (a diferencia de la cancelación, RB-RES-006) y no quedaba
  // rastro de por qué: una gripe avisada y un plantón se contaban igual.
  //
  // `noShowRefunded` no es solo informativo: es el cierre de la devolución
  // (`markBookingNoShow` en agenda-queries.ts solo incrementa
  // `Subscription.sessionsRemaining` cuando pasa de false a true), así que
  // volver a marcar la misma reserva no puede devolver la sesión dos veces.
  noShowReason   NoShowReason?
  noShowRefunded Boolean       @default(false)

  session      ClassSession    @relation(fields: [sessionId], references: [id])
  member       Member          @relation(fields: [memberId], references: [id])
  subscription Subscription?   @relation(fields: [subscriptionId], references: [id])
  debrief      SessionDebrief?

  @@index([sessionId])
  @@index([sessionId, occurrenceDate])
  @@index([memberId])
  @@index([memberId, occurrenceDate])
  @@index([status])
  @@index([subscriptionId])
}

// ---------- Cobros (A.2.3) ----------

enum PaymentMethod {
  CASH
  CARD
  BIZUM
  TRANSFER
  SEPA
  STRIPE // F12/RB-PAGO-001: cobro online (checkout o domiciliación) conciliado por webhook
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
}

model Payment {
  id                      String        @id @default(cuid())
  orgId                   String
  memberId                String
  subscriptionId          String?
  amountCents             Int
  method                  PaymentMethod
  status                  PaymentStatus @default(PAID)
  date                    DateTime
  receiptNumber           String?
  notes                   String?
  soldByUserId            String? // RB-RRHH-004: venta atribuida a trabajador (ranking mensual)
  stripeCheckoutSessionId String?       @unique // F12: sesión de checkout que originó el cobro
  stripePaymentIntentId   String?       @unique // F12: PaymentIntent confirmado por el webhook
  stripeInvoiceId         String?       @unique // F5: factura de Stripe Billing que originó el cobro recurrente (idempotencia de invoice.paid/payment_failed)
  createdAt               DateTime      @default(now())

  // PAGO-1 (RB-PAGO-002/003): aplazamiento local y devolución (modo registro local — D-2,
  // ver PAGO-2b para el refund real vía Stripe cuando el cliente entregue credenciales).
  dueDate        DateTime? // aplazamiento: fecha límite futura que excluye el pago de morosidad
  refundReason   String?
  refundedAt     DateTime?
  stripeRefundId String?   @unique // permanece NULL hasta PAGO-2b

  organization Organization  @relation(fields: [orgId], references: [id])
  member       Member        @relation(fields: [memberId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  soldBy       User?         @relation("SoldBy", fields: [soldByUserId], references: [id])

  @@unique([orgId, receiptNumber])
  @@index([orgId])
  @@index([memberId])
  @@index([date])
}

// ---------- Salud (A.2.4) — datos Art. 9 RGPD ----------
// Nota de diseño: en producción este modelo vive en un esquema separado
// (`health.*`, ADR-005) con cifrado a nivel de columna. En este entorno de
// demo se representa en el mismo esquema para simplificar, pero el acceso
// pasa siempre por lib/health-access.ts, que aplica la matriz de permisos
// y registra cada lectura en AuditLog (ADR-008).

enum HealthRecordType {
  INJURY
  CHRONIC_CONDITION
  MEDICATION
  SURGERY
  PREGNANCY
  ALLERGY
}

enum HealthSeverity {
  LOW
  MEDIUM
  HIGH
}

// Fases de una lesión o condición. El ciclo normal es
// ACTIVE → IN_REHAB → RESOLVED; `CHRONIC` es la salida lateral para lo que no
// va a resolverse nunca.
//
// Por qué `CHRONIC` es un ESTADO y no se unifica con `HealthRecordType.CHRONIC_CONDITION`:
// son dos ejes distintos y hacen falta los dos. El `type` dice QUÉ es (una
// lesión, una medicación, una alergia); el `status` dice EN QUÉ FASE está. Una
// lesión de hombro que ya no se va a curar es `type INJURY` + `status CHRONIC`,
// y sigue siendo una lesión a efectos del semáforo de aptitud (que empareja por
// `zone`, y `CHRONIC_CONDITION` no lleva zona). Al revés, el asma es
// `CHRONIC_CONDITION` y su fase puede ser ACTIVE (vigente) o RESOLVED
// (superada). Colapsar los dos ejes obligaría a perder uno de los dos datos.
//
// Lo que sí queda unificado es el COMPORTAMIENTO: "esto es permanente" se
// pregunta en un único sitio (`isChronicHealthRecord`, src/lib/health-status.ts),
// que cubre las dos formas de serlo. Ver docs/SALUD_LESIONES_FASES.md.
enum HealthStatus {
  ACTIVE // recién sufrida / vigente, sin plan de recuperación en marcha
  IN_REHAB // en rehabilitación
  RESOLVED // recuperada, ya no condiciona el entrenamiento
  CHRONIC // permanente: no se espera que se resuelva
}

model HealthRecord {
  id               String           @id @default(cuid())
  // Dato Art. 9 RGPD: cuelga de un socio O de un lead (nunca ambos), para que al
  // convertir el lead (RB-LEAD-007) el registro solo cambie de FK y no se
  // recapture el dato. Todo acceso sigue pasando por lib/health-access.ts.
  memberId         String?
  leadId           String?
  type             HealthRecordType
  zone             String? // p.ej. "hombro derecho"
  description      String
  severity         HealthSeverity
  status           HealthStatus     @default(ACTIVE)
  // Cuándo se produjo la lesión, que NO es cuándo se registró (`reportedAt`):
  // una lesión de hace ocho meses puede entrar en la ficha hoy, y el tiempo
  // transcurrido que se muestra en la ficha se deriva de esta fecha.
  injuryDate       DateTime?
  // `true` cuando el socio solo supo decir mes y año: el día guardado es
  // relleno (día 1) y la UI redondea el texto a meses en vez de fingir
  // precisión que no existe.
  injuryDateApprox Boolean          @default(false)
  // Última transición de `status`, para el "en rehabilitación desde hace X" de
  // la ficha. El QUIÉN y el histórico completo viven en `AuditLog`
  // (HEALTH_RECORD_STATUS_CHANGED), que es append-only; esto es solo la copia
  // de lectura del último cambio.
  statusChangedAt  DateTime?
  reportedByUserId String?
  reportedAt       DateTime         @default(now())
  resolvedAt       DateTime?
  consentSignedAt  DateTime?

  member     Member? @relation(fields: [memberId], references: [id])
  lead       Lead?   @relation(fields: [leadId], references: [id])
  reportedBy User?   @relation("ReportedBy", fields: [reportedByUserId], references: [id])

  @@index([memberId])
  @@index([leadId])
  @@index([status])
}

// Semáforo de Aptitud (G.2): reglas deterministas mantenidas por Sergio,
// no por el modelo de IA. La IA (F6, fuera de esta entrega) solo redactaría.
//
// La regla empareja por ZONA (`injuryZone` ↔ `HealthRecord.zone`) y no mira el
// `status` del registro: quien decide si una lesión cuenta es el lado del
// registro, filtrando por `OPEN_HEALTH_STATUSES` (src/lib/health-status.ts).
// Consecuencia deliberada para las fases nuevas: IN_REHAB y CHRONIC encienden
// el MISMO semáforo que ACTIVE. Una lesión en rehabilitación es justo la que
// más adaptación necesita, y una crónica no deja de limitar por ser antigua;
// solo RESOLVED apaga la luz. Ver docs/SALUD_LESIONES_FASES.md §4.
enum AptitudeLight {
  GREEN
  AMBER
  RED
}

model AptitudeRule {
  id             String        @id @default(cuid())
  orgId          String
  injuryZone     String // coincide con HealthRecord.zone
  blockArea      String // p.ej. "Empuje vertical"
  light          AptitudeLight
  adaptation     String? // p.ej. "reducir ROM, carga <=60%"
  editedByUserId String?
  updatedAt      DateTime      @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  editedBy     User?        @relation("EditedBy", fields: [editedByUserId], references: [id])

  @@index([orgId])
}

// Session Debrief (G.1): captura post-sesión en <20s, un toque por persona.
enum DebriefFeeling {
  GREEN
  AMBER
  RED
}

model SessionDebrief {
  id        String         @id @default(cuid())
  bookingId String         @unique
  feeling   DebriefFeeling
  rpe       Int?
  note      String?
  createdAt DateTime       @default(now())

  // Feedback 1-10 por socio al terminar la sesión (handoff C4). `rpe` ya
  // existía como esfuerzo percibido y sigue siendo el primer eje; el resto se
  // añade aquí. Todos son opcionales: el entrenador puede guardar a medias
  // (autoguardado por eje) y completar después.
  technique Int?
  attitude  Int?
  energy    Int?
  mobility  Int?
  pain      Int?
  adherence Int?
  progress  Int?
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
}

// ---------- Auditoría append-only (ADR-008) ----------

model AuditLog {
  id          String   @id @default(cuid())
  orgId       String
  actorUserId String?
  action      String // p.ej. "HEALTH_RECORD_READ", "MEMBER_UPDATED"
  entityType  String
  entityId    String
  memberId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  actor        User?        @relation(fields: [actorUserId], references: [id])

  @@index([orgId])
  @@index([entityType, entityId])
  @@index([memberId])
}

// ---------- Motor de retención (G.3) ----------

enum RetentionRiskLevel {
  LOW
  MEDIUM
  HIGH
}

// El motor (`src/lib/retention.ts`) solo usa OPEN y RECOVERED: abre una alerta
// cuando aparece la caída y la cierra sola cuando el socio vuelve a su ritmo.
// CONTACTED/POSTPONED/DISMISSED los escribía la pantalla `/retention`, retirada:
// se conservan porque hay filas históricas con esos estados, no porque se usen.
enum RetentionAlertStatus {
  OPEN
  CONTACTED
  POSTPONED
  DISMISSED
  RECOVERED
}

model RetentionAlert {
  id           String               @id @default(cuid())
  memberId     String
  baselineFreq Float // sesiones/semana, línea base personal (12 semanas)
  recentFreq   Float // sesiones/semana, últimas 2 semanas
  dropPct      Float // NEGATIVO: -76 = ha bajado un 76 %
  riskLevel    RetentionRiskLevel
  // Desde cuándo no viene. Nunca la causa clínica: replicar aquí un HealthRecord
  // lo sacaría del punto de lectura auditado (`health-access.ts`) y lo pondría
  // delante de roles sin acceso a salud.
  context      String?
  status       RetentionAlertStatus @default(OPEN)
  createdAt    DateTime             @default(now())
  resolvedAt   DateTime?

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@index([status])
  // El motor busca "la alerta viva de este socio" en cada pasada del cron.
  @@index([memberId, status])
}

// ---------- F8: Embudo de Leads / CRM comercial ----------

enum LeadStatus {
  SIN_CONTACTAR
  SEGUIMIENTO
  CON_FECHA_VALORACION
  CERRADO
  NO_CERRADO
}

// Tipo de cierre de un lead CERRADO (rediseño premium de Leads):
// EMBUDO = cierre tras seguimiento normal (por defecto al convertir).
// DIRECTO = alta presencial creada ya cerrada (owner = quien la atiende).
// ONLINE = generado por la plataforma al comprar por web; ownerUserId = null.
enum LeadCloseType {
  EMBUDO
  DIRECTO
  ONLINE
}

// Canales de origen ("cómo nos conociste") configurables por dirección sin
// desplegar (RB-LEAD-004), misma filosofía que AptitudeRule.
model LeadChannel {
  id        String   @id @default(cuid())
  orgId     String
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

// Motivos de no cierre configurables (RB-LEAD-011): obligatorio al pasar un
// lead a NO_CERRADO, editable por dirección sin desplegar.
model NoCloseReason {
  id        String   @id @default(cuid())
  orgId     String
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

model Lead {
  id                String         @id @default(cuid())
  orgId             String
  centerId          String
  firstName         String
  lastName          String
  phone             String // canal de reset por SMS (RB-LEAD-002)
  email             String? // condicional (RB-LEAD-002): teléfono o email, al menos uno
  postalCode        String // RB-LEAD-010: estructurado, no dirección libre
  occupation        String // alimenta BI nicho (RB-BI-003)
  hasChildren       Boolean? // BI demográfico (RB-BI-003), pregunta opcional
  sex               Sex? // BI-2/RB-BI-005: se hereda al Member al convertir (RB-LEAD-007)
  goals             String
  hasTrainedBefore  Boolean
  hasTrainedNote    String?
  channel           String // RB-LEAD-004: coincide con LeadChannel.label
  status            LeadStatus     @default(SIN_CONTACTAR)
  ownerUserId       String? // responsable del contacto (RB-LEAD-003)
  contactedAt       DateTime       @default(now()) // fecha de contacto automática (RB-LEAD-001)
  noCloseReason     String? // obligatorio al pasar a NO_CERRADO (RB-LEAD-011)
  closeType         LeadCloseType? // solo para CERRADO: embudo/directo/online
  convertedMemberId String?        @unique // enlace al Member creado si CERRADO (RB-LEAD-007)
  createdAt         DateTime       @default(now())

  organization    Organization   @relation(fields: [orgId], references: [id])
  center          Center         @relation(fields: [centerId], references: [id])
  owner           User?          @relation("LeadOwner", fields: [ownerUserId], references: [id])
  convertedMember Member?        @relation("LeadConvertedMember", fields: [convertedMemberId], references: [id])
  originForMember Member?        @relation("MemberOriginLead")
  notes           LeadNote[]
  healthRecords   HealthRecord[]

  @@index([orgId])
  @@index([centerId])
  @@index([status])
}

// Bitácora del lead (RB-LEAD-008), gemela de MemberNote pero para el embudo comercial.
model LeadNote {
  id           String   @id @default(cuid())
  orgId        String
  leadId       String
  authorUserId String?
  body         String
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  lead         Lead         @relation(fields: [leadId], references: [id])
  author       User?        @relation("LeadNoteAuthor", fields: [authorUserId], references: [id])

  @@index([orgId])
  @@index([leadId])
}

// ---------- F10: Notificaciones / tareas (transversal) ----------

enum NotificationKind {
  TASK
  ALERT
  INFO
}

/**
 * Prioridad de una tarea. Solo la fija el alta manual: lo que crea el motor de
 * reglas nace en MEDIA y no se toca, porque una regla no sabe lo que corre
 * prisa en un centro concreto. Tres niveles a propósito — con cinco nadie usa
 * los intermedios y el tablero deja de ordenar nada.
 */
enum TaskPriority {
  BAJA
  MEDIA
  ALTA
}

model Notification {
  id              String           @id @default(cuid())
  orgId           String
  recipientUserId String
  // Quién manda la tarea. Null en todo lo que genera el motor de reglas: ahí no
  // hay una persona detrás, y firmar esas filas con el usuario del cron sería
  // mentir sobre quién pidió el trabajo. Al reasignar NO se toca (RB-TASK-002):
  // cambia quién la hace, no quién la encargó.
  createdByUserId String?
  kind            NotificationKind @default(TASK)
  title           String
  body            String?
  entityType      String? // "Lead" | "Member" | "ClientFeedbackPrompt"...
  entityId        String?
  // Categoría libre de la tarea manual ("Comercial", "Instalaciones"...). Texto
  // y no enum: cada centro organiza su día a día a su manera, y un enum obliga a
  // migrar el esquema para añadir una etiqueta.
  category        String?
  priority        TaskPriority     @default(MEDIA)
  dueDate         DateTime?
  // Estado intermedio del tablero ("En curso"). El estado NO es una columna
  // propia: se deriva de estas dos marcas de tiempo (ver `taskStatus` en
  // lib/tasks-queries.ts). Con un campo `status` aparte habría dos fuentes de
  // verdad para lo mismo y `resolveNotification` —el único camino a "Hecha",
  // compartido con la campana y con el motor de reglas— tendría que mantener
  // las dos en sincronía.
  startedAt       DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime         @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  recipient    User         @relation("NotificationRecipient", fields: [recipientUserId], references: [id])
  createdBy    User?        @relation("NotificationCreator", fields: [createdByUserId], references: [id])

  @@index([orgId])
  @@index([recipientUserId])
  @@index([resolvedAt])
  // El tablero de tareas lee por organización + tipo + abiertas/histórico; sin
  // este índice cada carga recorre la tabla entera de notificaciones.
  @@index([orgId, kind, resolvedAt])
  @@index([createdByUserId])
}

// ---------- F13: RRHH — fichaje ----------

model TimeClockEntry {
  id        String    @id @default(cuid())
  orgId     String
  userId    String
  centerId  String
  workDate  DateTime
  clockIn   String // "HH:mm"
  clockOut  String?
  signedAt  DateTime? // firma digital de conformidad (RB-RRHH-001/002)
  createdAt DateTime  @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  center       Center       @relation(fields: [centerId], references: [id])

  @@index([orgId])
  @@index([userId])
}

// ---------- F14: Valoración de entrenadores ----------

// Valoración CONFIDENCIAL del entrenador por el socio (RB-RRHH-011/012): el
// acceso se centraliza en lib/trainer-rating-access.ts, que solo deja leer a
// dirección — nunca al propio entrenador, ni sobre sí mismo (matriz invertida
// respecto a health-access.ts).
model TrainerRating {
  id            String   @id @default(cuid())
  orgId         String
  trainerUserId String
  memberId      String // quién valora (no visible al entrenador)
  score         Int?
  strengths     String?
  improvements  String?
  createdAt     DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  trainer      User         @relation("TrainerRatingSubject", fields: [trainerUserId], references: [id])
  member       Member       @relation(fields: [memberId], references: [id])

  @@index([orgId])
  @@index([trainerUserId])
}

// ---------- F15: Programador de check-ins periódicos ----------

enum ServiceKind {
  GROUP
  PERSONAL_TRAINING
  ONLINE
}

// Intervalos configurables por org x tipo de servicio (decisión §11.6, defaults
// mensual/trimestral) para el check-in de objetivos (RB-IA-006) y la valoración
// de entrenadores (RB-RRHH-011). El programador de F10 emite las
// SelfAssessment/TrainerRating cuando corresponde.
model CheckinScheduleConfig {
  id                String      @id @default(cuid())
  orgId             String
  serviceKind       ServiceKind
  goalCheckinDays   Int         @default(30)
  trainerRatingDays Int         @default(90)
  updatedAt         DateTime    @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, serviceKind])
  @@index([orgId])
}

// ---------- F16: IA de programación, autovaloración y chat ----------

enum WorkoutProgramStatus {
  DRAFT
  PENDING_TRAINER
  ACTIVE
  COMPLETED
}

// Rutina generada por IA con confirmación humana obligatoria (RB-IA-001/003):
// el agente solo propone (createdByAI), un entrenador siempre confirma antes
// de que pase a ACTIVE (RB-IA-002: uso solo por staff).
model WorkoutProgram {
  id                String               @id @default(cuid())
  orgId             String
  memberId          String
  createdByAI       Boolean              @default(true)
  confirmedByUserId String?
  status            WorkoutProgramStatus @default(DRAFT)
  payload           Json
  createdAt         DateTime             @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  member       Member       @relation(fields: [memberId], references: [id])
  confirmedBy  User?        @relation("WorkoutConfirmedBy", fields: [confirmedByUserId], references: [id])

  @@index([orgId])
  @@index([memberId])
}

// Autovaloración del cliente (RB-IA-005) y check-in periódico de objetivos
// (RB-IA-006): la recomendación de IA se guarda junto a la respuesta para
// trazabilidad, con confirmación humana siempre presente aguas abajo.
model SelfAssessment {
  id               String   @id @default(cuid())
  orgId            String
  memberId         String
  kind             String // "mensual" | "estancamiento" | "check-in objetivos"
  text             String?
  structured       Json?
  aiRecommendation String?
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  member       Member       @relation(fields: [memberId], references: [id])

  @@index([orgId])
  @@index([memberId])
}

// Chat centro-cliente (RB-CHAT-001): visibilidad limitada al entrenador
// asignado + dirección; la IA puede escribir como participante (senderKind).
model Conversation {
  id        String   @id @default(cuid())
  orgId     String
  memberId  String   @unique
  createdAt DateTime @default(now())

  organization Organization  @relation(fields: [orgId], references: [id])
  member       Member        @relation(fields: [memberId], references: [id])
  messages     ChatMessage[]

  @@index([orgId])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderKind     String // "MEMBER" | "TRAINER" | "AI" | "DIRECTION"
  senderUserId   String?
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User?        @relation(fields: [senderUserId], references: [id])

  @@index([conversationId])
}

// ---------- Anuncios y banners del Dashboard del socio (D.1) ----------
// El Director de centros publica anuncios (imagen y/o texto) que el socio ve
// al aterrizar en su portal. Alcance mixto: `centerId` null = anuncio global
// de la empresa; con `centerId` = solo para socios de ese centro. Vigencia
// opcional (startsAt/endsAt): si ambos son null, el anuncio se muestra hasta
// que se desactiva/elimina a mano.

enum AnnouncementCategory {
  NEWS // informativo general
  EVENT // quedada, evento del club
  PROMO // promoción u oferta comercial
  ALERT // aviso importante (cierre, cambio de horario)
}

// Segmentación de audiencia dentro del portal del socio.
enum AnnouncementAudience {
  ALL // todos los socios
  MEMBERS // solo socios activos (excluye prospectos/prueba)
}

model Announcement {
  id          String               @id @default(cuid())
  orgId       String
  centerId    String? // null = anuncio global de la empresa
  title       String
  body        String? // texto informativo del anuncio
  imageUrl    String? // banner (data URL en esta demo)
  category    AnnouncementCategory @default(NEWS)
  audience    AnnouncementAudience @default(ALL)
  tags        String[]             @default([]) // etiquetas libres para clasificar
  pinned      Boolean              @default(false) // destacado: se muestra primero
  active      Boolean              @default(true)
  startsAt    DateTime? // inicio de vigencia (null = desde ya)
  endsAt      DateTime? // fin de vigencia (null = sin expiración)
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  organization Organization       @relation(fields: [orgId], references: [id])
  center       Center?            @relation(fields: [centerId], references: [id])
  createdBy    User?              @relation("AnnouncementAuthor", fields: [createdById], references: [id])
  views        AnnouncementView[]

  @@index([orgId])
  @@index([centerId])
}

// Analítica de vistas: un socio cuenta como una vista por anuncio (RB-ANUN-003).
model AnnouncementView {
  id             String   @id @default(cuid())
  announcementId String
  memberId       String
  viewedAt       DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id])

  @@unique([announcementId, memberId])
  @@index([announcementId])
  @@index([memberId])
}

// ---------- Stripe Connect (gimnasio → socios, Parte C) ----------
// La cuenta Stripe es un dato POR organización (D-S1), no global. Reemplaza el
// uso de la clave global para cobrar a socios. Sigue habiendo UNA sola clave
// secreta (la de Apta): aquí solo se guarda el id de la cuenta conectada,
// nunca una clave del gimnasio (RB-CONNECT-001).
model StripeAccount {
  id             String   @id @default(cuid())
  orgId          String   @unique
  accountId      String   @unique // acct_... conectado por el gimnasio (Connect Standard, OAuth)
  chargesEnabled Boolean  @default(false) // el gimnasio completó el onboarding de Stripe
  payoutsEnabled Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
}

// ---------- Biblioteca de entrenamientos online (D.2) ----------
// El socio con plan ONLINE no reserva sesiones presenciales: accede a esta
// biblioteca de entrenamientos pregrabados, sin límite de sesiones.
model OnlineWorkout {
  id           String   @id @default(cuid())
  orgId        String
  title        String
  description  String?
  category     String // "Fuerza" | "Movilidad" | "HIIT" ...
  level        String // "Principiante" | "Intermedio" | "Avanzado"
  durationMin  Int
  thumbnailUrl String?
  videoUrl     String
  active       Boolean  @default(true)
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

// ---------- App móvil nativa (F0) — auth por token ----------
// La sesión web usa cookie (NextAuth); la app nativa no puede leerla. El
// access token (JWT corto) se valida sin tocar la BD; este refresh token
// (opaco, rotatorio) es lo único que se persiste, para poder revocar sesiones
// de dispositivo (logout) y detectar reuso de un token ya rotado.
model MobileRefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique // sha256 del token opaco; nunca se guarda en claro
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  replacedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Valoración del socio (F1 declara el esquema; F3 la lógica) ----------
// Valoración inicial y sus revisiones periódicas. `answers` guarda el
// cuestionario completo tal y como se respondió (Json y no columnas: el
// formulario evoluciona y no queremos una migración por pregunta nueva); las
// marcas medibles NO viven aquí, sino en PerformanceMetric, porque son una
// serie temporal y no una foto puntual.
model Assessment {
  id             String         @id @default(cuid())
  orgId          String
  memberId       String
  kind           AssessmentKind
  dueDate        DateTime
  completedAt    DateTime?
  /// Cuándo el socio rellenó SU parte de la valoración inicial (F-ALTA: perfil,
  /// experiencia y constantes). Es una marca propia y no un `completedAt` a
  /// medias porque la valoración sigue abierta después: el screening, el PAR-Q
  /// y las marcas físicas los añade el entrenador con el socio delante (F3
  /// §4.2), y hasta entonces no hay nada que propagar a salud ni a objetivos.
  /// Null en las revisiones (M1/M3/…), que no tienen parte de autoservicio.
  memberPartAt   DateTime?
  answers        Json
  filledByUserId String? // quién la cumplimentó; null si la rellenó el propio socio
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  member       Member       @relation(fields: [memberId], references: [id])
  filledBy     User?        @relation("AssessmentFilledBy", fields: [filledByUserId], references: [id])

  @@index([orgId])
  @@index([memberId, kind])
}

/// Hitos de revisión desde el alta: inicial, mes 1/3/6/9 y aniversario.
enum AssessmentKind {
  INITIAL
  M1
  M3
  M6
  M9
  Y1
}

// Serie temporal de marcas medibles ("simulacro dominadas: 2 reps", tiempos de
// circuito). Separada de Assessment: una marca puede registrarse en una
// valoración, en una sesión suelta o a mano, y lo que interesa es su evolución.
model PerformanceMetric {
  id         String   @id @default(cuid())
  orgId      String
  memberId   String
  key        String // "dominadas_reps", "circuito_agilidad_s"
  value      Float
  unit       String
  recordedAt DateTime
  source     String // "assessment" | "session" | "manual"
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  member       Member       @relation(fields: [memberId], references: [id])

  @@index([orgId])
  @@index([memberId, key, recordedAt])
}

// ---------- Mesociclo (F1 declara el esquema; F6 la lógica) ----------
// Plan de entrenamiento por fases de un socio. Visible SOLO para el entrenador:
// no se expone en el portal del socio ni en la app móvil.
model Mesocycle {
  id               String          @id @default(cuid())
  orgId            String
  memberId         String
  createdByUserId  String
  status           MesocycleStatus @default(DRAFT)
  title            String
  objective        String
  safetyCriteria   Json // heredado del screening de la valoración: lo que NO se puede programar
  weeklyLayout     Json // "Lun TZ · Mié TZ · Vie TZ · Mar Gym · Jue Gym"
  milestones       Json // hoja de ruta: semana → hitos medibles
  aiConversation   Json? // historial multi-turno del refinado con la IA
  approvedAt       DateTime?
  approvedByUserId String?
  createdAt        DateTime        @default(now())

  organization Organization     @relation(fields: [orgId], references: [id])
  member       Member           @relation(fields: [memberId], references: [id])
  createdBy    User             @relation("MesocycleCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy   User?            @relation("MesocycleApprovedBy", fields: [approvedByUserId], references: [id])
  phases       MesocyclePhase[]

  @@index([orgId])
  @@index([memberId])
}

enum MesocycleStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

model MesocyclePhase {
  id          String  @id @default(cuid())
  mesocycleId String
  order       Int
  name        String
  weekFrom    Int
  weekTo      Int
  notes       String?

  mesocycle Mesocycle      @relation(fields: [mesocycleId], references: [id], onDelete: Cascade)
  days      MesocycleDay[]

  @@index([mesocycleId])
}

model MesocycleDay {
  id      String @id @default(cuid())
  phaseId String
  order   Int
  label   String // "Lunes", "Día 1"...
  venue   String // dónde se entrena ese día: "TZ" | "Gym" | ...
  focus   String
  warmup  Json

  phase  MesocyclePhase   @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  blocks MesocycleBlock[]

  @@index([phaseId])
}

model MesocycleBlock {
  id          String @id @default(cuid())
  dayId       String
  order       Int
  name        String
  durationMin Int

  day       MesocycleDay        @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercises MesocycleExercise[]

  @@index([dayId])
}

model MesocycleExercise {
  id          String  @id @default(cuid())
  blockId     String
  order       Int
  name        String
  sets        Int
  reps        String // "8-10", "AMRAP 30s": no siempre es un número
  load        String?
  description String
  /// El "porqué" del ejercicio (con su referencia bibliográfica). Es lo que
  /// separa el mesociclo de una plantilla de Excel: no se omite.
  rationale   String

  block MesocycleBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId])
}
